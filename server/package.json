{
  "name": "rally-lobby-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "start:3d": "cd .. && node --env-file-if-exists=.env server/tripo.mjs",
    "test": "node --test server.test.mjs tripo.test.mjs game.test.mjs",
    "test:integration": "node --test next.test.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
