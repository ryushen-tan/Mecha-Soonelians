# Lobby rooms in Supabase. Placeholders only; never commit real values.
# Local: copy to server/.env.local. Vercel: Project Settings > Environment Variables.
# Setup steps: Docs/Supabase.md

# Postgres through the Supavisor transaction pooler (port 6543), signed in as the rally_api role.
# Copy the "Transaction pooler" string from Supabase > Connect, then replace the user
# (postgres.<project-ref> -> rally_api.<project-ref>) and the password (URL-encoded).
RALLY_DATABASE_URL=postgresql://rally_api.your-project-ref:your-rally-api-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Optional: the database CA certificate (PEM) from Supabase > Database settings > SSL Configuration.
# With it the server certificate is verified; without it the connection is encrypted but unverified.
RALLY_DATABASE_CA_CERT=

# Storage API, for disguise GLBs in the private rally-disguises bucket.
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. Server only: never ship it in the app.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# Legacy service_role JWT (starts with eyJ). Server only. Needed for online AR rounds: Storage only
# creates signed upload/download links for the scanned house and ghosts when called with a JWT,
# not with an sb_secret_ key. Supabase > Project Settings > API Keys > Legacy.
SUPABASE_SERVICE_ROLE_KEY=eyJ-your-legacy-service-role-jwt

# Local Wi-Fi play only: keep rooms in this single process instead of Supabase.
# RALLY_STORE=memory
